# Generate a strong random key for local authenticated scoring.
RISK_MESH_API_KEY=replace-with-a-random-secret-at-least-24-characters
RISK_MESH_DB_PATH=/tmp/riskmesh.db

# Required for cryptographically signed advanced risk investigations.
RISK_MESH_SIGNING_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
